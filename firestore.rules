rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /studentDashboardSync/{docId} {
      allow read, write: if true;
    }
    match /cloudTokenSync/{docId} {
      allow read, write: if true;
    }
    match /classroomChats/{roomId} {
      allow read: if true;
      allow write: if request.resource.data.messages is list;
    }
    match /classroomAnnouncements/{roomId} {
      allow read: if true;
      allow write: if request.resource.data.announcements is list;
    }
    match /classroomSeats/{roomId} {
      allow read: if true;
      allow write: if request.resource.data.seats is list;
    }
    match /studentAttendance/{docId} {
      allow read, write: if true;
    }
    match /studentBiometrics/{docId} {
      allow read, write: if true;
    }
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
